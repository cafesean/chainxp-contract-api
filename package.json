{
  "name": "fastify-serverless",
  "version": "1.0.0",
  "description": "",
  "main": "src/local.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node build/local.js",
    "dev": "tsx watch src/local.ts",
    "build": "rm -rf build && pnpm gen && pnpm hh && tsc --build tsconfig.json && cp -r contracts/artifacts/contracts src/lib &&  cp -r src/lib build/src && cp -r contracts build && cp -r typechain-types build && cp -r prisma build && cp vercel.json build/src",
    "hh": "rm -rf src/lib && npx hardhat compile",
    "n": "npx hardhat node",
    "gen": "prisma generate",
    "local:start": "fastify start -l info app.js",
    "local:dev": "fastify start -w -l info -P app.js",
    "postinstall": "prisma generate",
    "layer": "rm -rf layer/nodejs && find node_modules -maxdepth 1  ! -path 'node_modules/.*' ! -path 'node_modules/.pnpm' -exec cp -L -r {} layer/nodejs/ \\; && gzip -r layer/nodejs"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@fastify/autoload": "^5.4.1",
    "@fastify/cors": "^8.1.0",
    "@fastify/helmet": "^10.0.1",
    "@fastify/jwt": "^6.3.2",
    "@fastify/multipart": "^7.2.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^1.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.4",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.6",
    "@nomicfoundation/hardhat-toolbox": "^2.0.2",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@nomiclabs/hardhat-ethers": "^2.2.1",
    "@nomiclabs/hardhat-etherscan": "^3.1.2",
    "@prisma/client": "^5.1.1",
    "@sinclair/typebox": "^0.24.46",
    "@typechain/ethers-v5": "^10.1.1",
    "@typechain/hardhat": "^6.1.4",
    "@types/chai": "^4.3.3",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.11.9",
    "chai": "^4.3.6",
    "dotenv": "^16.3.1",
    "ethers": "^5.7.2",
    "fastify": "4.9.2",
    "fastify-cli": "^5.5.0",
    "fastify-plugin": "^4.3.0",
    "fastify-tsconfig": "^1.0.1",
    "hardhat": "^2.17.1",
    "moment-timezone": "^0.5.38",
    "solidity-coverage": "^0.8.2",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.1",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@fastify/auth": "^4.3.0",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/contracts-upgradeable": "^4.9.3",
    "@typechain/ethers-v6": "^0.4.3",
    "alchemy-sdk": "^2.9.2",
    "axios": "^1.2.1",
    "error-stack-parser": "^2.1.4",
    "http-status-codes": "^2.2.0",
    "ioredis": "^5.2.4",
    "prisma": "^5.1.1",
    "tsx": "^3.12.7",
    "web3": "^4.3.0"
  },
  "packageManager": "pnpm@7.26.1",
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": false,
    "printWidth": 80,
    "proseWrap": "never",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "useTabs": false,
    "vueIndentScriptAndStyle": false,
    "rangeStart": 0
  }
}
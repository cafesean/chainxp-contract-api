{
  "name": "fastify-serverless",
  "version": "1.0.0",
  "description": "",
  "main": "local.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "pnpm build && node dist/src/server.js",
    "dev": "tsx watch src/local.ts",
    "build": "rm -rf dist && pnpm gen && cd src && tsc --build tsconfig.json && cp -r lib ../dist/src",
    "test": "tap \"test/**/*.test.js\"",
    "gen": "prisma generate",
    "local:start": "fastify start -l info app.js",
    "local:dev": "fastify start -w -l info -P app.js",
    "postinstall": "prisma generate",
    "layer": "rm -rf layer/nodejs && find node_modules -maxdepth 1  ! -path 'node_modules/.*' ! -path 'node_modules/.pnpm' -exec cp -L -r {} layer/nodejs/ \\; && gzip -r layer/nodejs"
  },

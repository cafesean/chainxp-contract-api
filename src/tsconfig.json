{
	"extends": "fastify-tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@root/*": [ "./*" ],
			"@service/*": [ "./service/*" ],
			"@providers/*": [ "./providers/*" ],
			"@constants/*": [ "./constants/*" ],
			"@schemas/*": [ "./schemas/*" ],
		},
		"allowJs": true,
		"declaration": false,
		"outDir": "../dist/src",
		"target": "es2020",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": false,
		"skipLibCheck": true
	},
	"include": [ "**/*.ts", "lib/**/*.sol", "vercel.json" ],
}

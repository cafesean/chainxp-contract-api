{
	"extends": "fastify-tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@root/*": [ "./*" ],
			"@service/*": [ "./service/*" ],
			"@providers/*": [ "./providers/*" ],
			"@constants/*": [ "./constants/*" ],
			"@schemas/*": [ "./schemas/*" ],
		},
		"outDir": "build",
		"target": "es2020",
		"allowJs": true,
		"esModuleInterop": true,
		"moduleResolution": "node",
		"module": "commonjs",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"declaration": false
	},
	"include": [ "api/**/*", "src/**/*"],
	"files": ["hardhat.config.ts", "cache/solidity-files-cache.json" ]
}

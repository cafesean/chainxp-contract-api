generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model allowlist {
  class_id              String?
  contract_address      String?
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  id                    String              @id(map: "allowlist_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  is_owned              Boolean?            @default(false)
  token_id              String?
  updated_at            DateTime?           @updatedAt @db.Timestamptz(6)
  user_address          String?
  xp_id                 Int?
  status                Int?
  series_id             Int?
  attributes            Json?
  credit_transaction_id Int?
  task_id               Int?
  credit_transaction    credit_transaction? @relation(fields: [credit_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "allowlist_credit_transaction_id_fkey")
  xp                    xp?                 @relation(fields: [xp_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "allowlist_new_xp_id_fkey")
}

model category {
  id    Int     @id @default(autoincrement())
  slug  String
  name  String
  image String?
}

model clone {
  id                Int        @id @default(autoincrement())
  name              String
  type              String?
  owner_address     String
  contract_address  String     @unique
  factory_address   String
  delegate_address  String?
  status            Int
  chain_id          Int?
  deployed_at       DateTime   @default(now()) @db.Timestamptz(6)
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @updatedAt @db.Timestamptz(6)
  proxy_address     String
  fungible          Boolean?   @default(true)
  forwarder_address String?
  forwarder         forwarder? @relation(fields: [forwarder_address], references: [address], onDelete: NoAction, onUpdate: NoAction, map: "clone_forwarder_address_fkey")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by the Prisma Client.
model contract {
  contract_address    String
  name                String            @db.VarChar(250)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  chain               String?
  chain_id            Int?
  contract_name       String?
  deployed_at         DateTime?         @default(now()) @db.Timestamptz(6)
  id                  Int               @id @default(autoincrement())
  owner_address       String?
  status              Int?
  type                String?
  version             String?
  abi                 String?
  bytecode            String?
  source_name         String?
  factory_address     String?
  cloned_from         String?
  contract_version_id Int?
  forwarder_address   String?
  deployment_id       Int?
  contract_version    contract_version? @relation(fields: [contract_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contract_contract_version_id_key")
  deployment          deployment?       @relation(fields: [deployment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "contract_deployment_id_key")
  forwarder           forwarder?        @relation(fields: [forwarder_address], references: [address], onDelete: NoAction, onUpdate: NoAction, map: "contract_forwarder_address_fkey")

  @@unique([contract_name, deployment_id])
}

model contract_version {
  id            Int        @id @default(autoincrement())
  contract_name String
  source_name   String
  version       String
  network       String?
  abi           String
  bytecode      String
  group         String?
  default       Boolean
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  tier_id       Int?
  chain_id      Int?       @db.SmallInt
  contract      contract[]
}

model deployment {
  id                        Int        @id @default(autoincrement())
  proxy_contract_address    String?
  delegate_contract_address String?
  factory_contract_address  String?
  name                      String
  description               String?
  network                   String
  chain                     String
  status                    Int
  deployed_at               DateTime?  @default(now())
  created_at                DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime   @updatedAt @db.Timestamptz(6)
  wallet_address            String
  metadata                  Json?
  contract                  contract[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model forwarder {
  key         String?
  tier_id     Int        @default(1)
  iv          String?
  address     String?    @unique
  id          Int        @id @default(autoincrement())
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @updatedAt @db.Timestamptz(6)
  chain       String?
  role        String?
  status      Int        @default(100)
  token       Json?
  description String?
  salt        String?
  clone       clone[]
  contract    contract[]
}

model inventory {
  wallet_address   String
  network          String
  contract_address String
  class_id         String
  name             String?
  symbol           String?
  uri              String?

  @@id([wallet_address, contract_address, class_id])
}

model org {
  id                     Int        @id @default(autoincrement())
  created_at             DateTime?  @default(now()) @db.Timestamptz(6)
  name                   String?
  country_id             Int?
  type                   Int?       @db.SmallInt
  logo_url               String?
  slug                   String?
  uuid                   String?    @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  updated_at             DateTime?  @updatedAt @db.Timestamptz(6)
  status                 Int?       @db.SmallInt
  tier_id                Int        @default(1)
  category_id            Int?
  plan_id                Int?
  verified_at            DateTime?
  allowlist              String[]
  business_address       String?
  business_licenses      String[]
  linkedin_url           String?
  member_token_image_url String?
  website                String?
  auth_wallets           Json[]
  credit_balance         Float?     @default(0)
  credit                 credit[]
  org_user               org_user[]
  series                 series[]
}

model org_scheme {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
  status     Int?      @db.SmallInt
  scheme     Int?
}

model org_user {
  org_id    Int
  user_uuid String? @db.Uuid
  role      String
  user_id   Int
  org       org     @relation(fields: [org_id], references: [id])
  user      user    @relation(fields: [user_id], references: [id])

  @@id([org_id, user_id])
}

model role {
  id          Int           @id(map: "roles_pkey") @default(autoincrement())
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?     @updatedAt @db.Timestamptz(6)
  name        String?
  title       String
  policy_ops  Json?         @db.Json
  policy_org  Json?         @db.Json
  role_policy role_policy[]
}

model role_policy {
  id         Int       @id @default(autoincrement())
  role_id    Int
  name       String
  can_create Boolean   @default(false)
  can_read   Boolean   @default(false)
  can_update Boolean   @default(false)
  can_delete Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
  metadata   Json?
  role       role      @relation(fields: [role_id], references: [id])
}

model scheme {
  id            Int       @id(map: "schemes_pkey") @default(autoincrement())
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)
  name          String?
  contracts     Json[]
  access_policy Json?
}

model series {
  id               Int       @id @default(autoincrement())
  org_id           Int?
  category         Int?      @db.SmallInt
  title            String?
  description      String?
  image_url        String?
  banner_url       String?
  attributes       Json?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  contract_version String?
  tokens           Json?
  slug             String?
  uuid             String?   @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requirements     String?
  contract_address String?   @unique
  owner            String?
  delegate_address String?
  template_id      Int?
  external_link    String?
  status           Int       @default(0)
  fungible         Boolean?  @default(false)
  type             Int       @default(1)
  carousel         String[]
  org_logo_url     String?
  user_id          Int?
  org              org?      @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template         template? @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "series_template_id_key")
  xp               xp[]
}

model template {
  id                     Int       @id(map: "template2_pkey") @default(autoincrement())
  template_name          String?   @default("")
  mask                   String?   @default("")
  gradient               String?   @default("")
  gradient_offset_1      String?   @default("{'percent':'0','color':'000000','opacity':'0'}")
  gradient_offset_2      String?   @default("{'percent':'0','color':'000000','opacity':'0'}")
  gradient_offset_3      String?   @default("{'percent':'0','color':'000000','opacity':'0'}")
  gradient_offset_4      String?   @default("{'percent':'0','color':'000000','opacity':'0'}")
  base_style             String?   @default("")
  bg_color               String?   @default("")
  image_uri              String?   @default("")
  image_scale            String?   @default("")
  image_h                String?   @default("")
  org_logo_uri           String?   @default("")
  org_logo_scale         String?   @default("")
  org_logo_w             String?   @default("")
  org_text               String?   @default("")
  org_font               String?   @default("")
  org_font_size          String?   @default("")
  series_text            String?   @default("")
  series_font            String?   @default("")
  series_font_size       String?   @default("")
  series_font_color      String?   @default("")
  xp_text                String?   @default("")
  xp_font                String?   @default("")
  xp_font_color          String?   @default("")
  xp_font_size           String?   @default("")
  xp_font_weight         String?   @default("")
  chainxp_logo_uri       String?   @default("")
  chainxp_logo_transform String?   @default("")
  chainxp_logo_color     String?   @default("")
  factor                 String?   @default(".5")
  radius                 String?   @default("175")
  rotation               String?   @default("0")
  sides                  String?   @default("4")
  gradient_offset1       Json?     @db.Json
  gradient_offset2       Json?     @db.Json
  gradient_offset3       Json?     @db.Json
  gradient_offset4       Json?     @db.Json
  image_xy               Json?     @db.Json
  org_logo_xy            Json?     @db.Json
  org_text_xy            Json?     @db.Json
  series_text_xy         Json?     @db.Json
  xp_text_xy             Json?     @db.Json
  chainxp_logo_xy        Json?     @db.Json
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @updatedAt @db.Timestamptz(6)
  shared                 Boolean   @default(false)
  mask_xy                Json?     @db.Json
  base_stroke            String?   @default("")
  series_font_weight     String?   @default("")
  shape_stroke_color     String?   @default("")
  shape_stroke_width     String?   @default("")
  series                 series[]
}

model transaction {
  txn_hash         String    @id
  class_id         String
  from             String
  to               String
  status           Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  contract_address String?
  token_id         String?
  amount           Decimal?  @db.Decimal
  method           String?
  nonce            Int?      @default(0)
  parentNonce      Int?      @default(0)
}

model transaction_deploy {
  txn_hash         String    @id
  status           Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  contract_address String?
  method           String?
  nonce            Int?      @default(0)
  parentNonce      Int?      @default(0)
}

model transaction_xp {
  txn_hash         String    @id
  class_id         String
  status           Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  contract_address String?
  method           String?
  nonce            Int?      @default(0)
  parentNonce      Int?      @default(0)
}

model user {
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  status        Int?          @db.SmallInt
  wallets       String[]
  attributes    Json?
  tokens        Json?
  xp            Json?
  profile       Json?
  role_id       Int[]
  org_id        Int[]
  updated_at    DateTime?     @updatedAt @db.Timestamptz(6)
  referred_by   String?
  is_registered Boolean?
  name          String?
  email         Json?         @db.Json
  password      String?
  phone         Json?         @db.Json
  avatar        String?
  username      String?
  uuid          String        @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  id            Int           @id @default(autoincrement())
  org_user      org_user[]
  user_wallet   user_wallet[]
}

model xp {
  id               Int         @id @default(autoincrement())
  created_at       DateTime?   @default(now()) @db.Timestamptz(6)
  status           Int?        @db.SmallInt
  xp_code          String?
  title            String?
  description      String?
  series_id        Int?
  image_url        String?
  slug             String?
  uuid             String?     @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  updated_at       DateTime?   @default(now()) @updatedAt @db.Timestamptz(6)
  class_id         String?
  contract_address String?
  xp_font          String?
  xp_font_color    String?
  xp_font_size     String?
  xp_font_weight   String?
  xp_text_x        String?
  xp_text_y        String?
  external_link    String?
  requirements     Json?
  attributes       Json?
  task_type_id     Int?
  allowlist        allowlist[]
  task             task[]
  series           series?     @relation(fields: [series_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task_type        task_type?  @relation(fields: [task_type_id], references: [id])
  xp_type          xp_type?    @relation(fields: [xp_code], references: [xp_code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([contract_address, class_id])
}

model xp_type {
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  name        String?
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  description String?
  xp_code     String    @id
  xp          xp[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model version {
  id         Int       @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  version    String?
  chain      Int?
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
}

model verification_token {
  id         Int       @id @default(autoincrement())
  user_uuid  String?   @db.Uuid
  type       String
  value      String
  used_at    DateTime? @db.Timestamptz(6)
  expired_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  metadata   Json?
  user_id    Int?
}

model task {
  id               Int           @id @default(autoincrement())
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @updatedAt @db.Timestamptz(6)
  task_provider_id Int
  xp_id            Int
  participants     Json?
  dependent_tasks  Int?
  users            Json[]
  task_type_id     Int?
  task_provider    task_provider @relation(fields: [task_provider_id], references: [id])
  task_type        task_type?    @relation(fields: [task_type_id], references: [id])
  xp               xp            @relation(fields: [xp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model task_type {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  task        task[]
  xp          xp[]
}

model task_provider {
  id          Int       @id @default(autoincrement())
  name        String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  api_url     String?
  description String?
  task        task[]
}

model credit {
  id          Int       @id @default(autoincrement())
  org_id      Int
  campaign_id Int?
  type        String?
  amount      Float
  awarded_at  DateTime  @default(now()) @db.Timestamptz(6)
  expire_at   DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  campaign    campaign? @relation(fields: [campaign_id], references: [id])
  org         org       @relation(fields: [org_id], references: [id])
}

model credit_transaction {
  id                  Int              @id @default(autoincrement())
  user_uuid           String?          @db.Uuid
  amount              Float
  activity            String?
  transaction_type_id Int
  transacted_at       DateTime         @db.Timestamptz(6)
  txn_hash            String
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?        @updatedAt @db.Timestamptz(6)
  status              String
  org_id              Int
  user_id             Int?
  allowlist           allowlist[]
  transaction_type    transaction_type @relation(fields: [transaction_type_id], references: [id])
}

model transaction_type {
  id                 Int                  @id @default(autoincrement())
  name               String
  credits_required   Float
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @updatedAt @db.Timestamptz(6)
  plan_id            Int?
  chain_id           Int?                 @default(0)
  description        String?
  status             Int                  @default(1)
  credit_transaction credit_transaction[]
}

model campaign {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  credit_pool Float
  tier_id     Int?
  rules       Json?
  status      Int
  start_at    DateTime? @default(now()) @db.Timestamptz(6)
  end_at      DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  credit      credit[]
}

model plan {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  network     String
  credits     Float
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
}

model user_wallet {
  id         Int       @id @default(autoincrement())
  user_id    Int
  key        String
  iv         String
  address    String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  status     Int       @default(1)
  salt       String
  user       user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
